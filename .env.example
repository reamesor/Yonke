# Yonke — public flags (safe to expose). Secrets stay server-only.

NEXT_PUBLIC_PAYOUT_MODE=PER_COLOR
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SIWS_ENABLED=false
NEXT_PUBLIC_DEVNET_CUSTODY=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional RPC
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Server-only — never commit real values
# SERVER_SEED_SECRET=
# SIWS_SESSION_SECRET=
# HOUSE_WALLET_SECRET_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# FAIRNESS_DURABLE_STORE=memory
